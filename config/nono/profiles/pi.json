{
  "meta": {
    "name": "pi",
    "version": "1.0.0",
    "description": "pi.dev sandbox — standalone, no conflicting deny groups"
  },
  "security": {
    "signal_mode": "isolated",
    "process_info_mode": "isolated",
    "ipc_mode": "shared_memory_only"
  },
  "groups": {
    "include": [
      "node_runtime",
      "python_runtime",
      "rust_runtime",
      "git_config",
      "unlink_protection",
      { "name": "user_caches_linux", "when": "linux" },
      { "name": "system_read_linux_core", "when": "linux" },
      { "name": "system_write_linux", "when": "linux" }
    ]
  },
  "filesystem": {
    "allow": [
      "$WORKDIR",
      "$HOME/.pi/nono-agent",
      "$HOME/Code/dotfiles/config/pi/nono-agent",
      "$HOME/.npm",
      "$TMPDIR"
    ],
    "read": [
      "$HOME/.nodenv",
      "$HOME/.nodenv/shims",
      "$HOME/.local/share/cargo",
      "$HOME/.cargo",
      "$HOME/.rustup",
      "$HOME/.config/nono/packages",
      "$HOME/.config/nono/profiles",
      "$HOME/.agents",
      "$HOME/.local/share/opencode",
      "$HOME/.cache/uv",
      "/etc/uv",
      "$HOME/.gitconfig",
      "$HOME/.gitconfig.local",
      "$HOME/.ssh",
      "$HOME/.gnupg",
      "/usr/local/bin"
    ],
    "suppress_save_prompt": [
      "$WORKDIR/node_modules",
      "$WORKDIR/__pycache__",
      "$WORKDIR/target",
      "$WORKDIR/.next"
    ]
  },
  "network": {
    "block": false
  },
  "workdir": {
    "access": "readwrite"
  },
  "environment": {
    "set_vars": {
      "PI_CODING_AGENT_DIR": "$HOME/.pi/nono-agent",
      "PI_CODING_AGENT_SESSION_DIR": "$HOME/.pi/nono-agent/sessions"
    }
  },
  "undo": {
    "exclude_patterns": [
      "node_modules",
      ".next",
      "__pycache__",
      "target",
      ".pi",
      ".git"
    ],
    "exclude_globs": ["*.tmp.[0-9]*.[0-9]*"]
  },
  "interactive": true
}
