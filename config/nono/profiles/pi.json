{
  "meta": {
    "name": "pi",
    "description": "pi.dev sandbox"
  },
  "groups": {
    "include": [
      "node_runtime",
      "python_runtime",
      "git_config",
      "unlink_protection",
      { "name": "user_caches_linux", "when": "linux" },
      { "name": "system_read_linux_core", "when": "linux" },
      { "name": "system_write_linux", "when": "linux" }
    ]
  },
  "filesystem": {
    "allow": [
      "$HOME/.npm",
      "$HOME/.pi/nono-agent",
      "$HOME/Code/dotfiles/config/pi/nono-agent",
      "$TMPDIR",
      "$WORKDIR"
    ],
    "read": [
      "$HOME/.agents",
      "$HOME/.cache/uv",
      "$HOME/.cargo",
      "$HOME/.config/nono/packages",
      "$HOME/.config/nono/profiles",
      "$HOME/.gitconfig",
      "$HOME/.gitconfig.local",
      "$HOME/.local/share/opencode",
      "$HOME/.nodenv",
      "$HOME/Code",
      "/etc/uv",
      "/usr/local/bin"
    ],
    "suppress_save_prompt": [
      "$WORKDIR/node_modules",
      "$WORKDIR/__pycache__",
      "$WORKDIR/target",
      "$WORKDIR/.next"
    ]
  },
  "workdir": {
    "access": "readwrite"
  },
  "environment": {
    "set_vars": {
      "PI_CODING_AGENT_DIR": "$HOME/.pi/nono-agent",
      "PI_CODING_AGENT_SESSION_DIR": "$HOME/.pi/nono-agent/sessions"
    }
  },
  "undo": {
    "exclude_patterns": [
      "node_modules",
      ".next",
      "__pycache__",
      "target",
      ".pi",
      ".git"
    ],
    "exclude_globs": ["*.tmp.[0-9]*.[0-9]*"]
  }
}
