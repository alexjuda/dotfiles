{
    "permission": {
        "*": "allow",
        "path": {
            "*": "allow",
            "*.direnv": "deny",
            "*.direnv.*": "deny",
            "*.env": "deny",
            "*.env.*": "deny",
            "*.env.example": "allow",
            "~/.config/opencode/skills/*": "allow",
            "~/.nodenv/versions/*/lib/node_modules/@earendil-works/pi-coding-agent/docs/*": "allow"
        },
        "bash": {
            "*": "ask",
            "*/scripts/notion_mcp.py *": "allow",
            "./exa-search *": "allow",
            "./searxng_search.py *": "allow",
            "argocd app get *": "allow",
            "awk *": "allow",
            "bd *": "allow",
            "cat *": "allow",
            "cd *": "allow",
            "cut *": "allow",
            "date *": "allow",
            "echo *": "allow",
            "fd *": "allow",
            "find *": "allow",
            "for *": "allow",
            "gh pr diff *": "allow",
            "gh pr list *": "allow",
            "gh pr view *": "allow",
            "gh run list *": "allow",
            "gh run view *": "allow",
            "git branch --show-current": "allow",
            "git branch -a": "allow",
            "git branch": "allow",
            "git diff *": "allow",
            "git fetch *": "allow",
            "git grep *": "allow",
            "git log *": "allow",
            "git ls-files *": "allow",
            "git ls-remote *": "allow",
            "git merge-base *": "allow",
            "git rev-parse *": "allow",
            "git remote -v": "allow",
            "git show *": "allow",
            "git status *": "allow",
            "git tag --list *": "allow",
            "git worktree *": "allow",
            "gofmt *": "allow",
            "grep *": "allow",
            "head *": "allow",
            "helm lint *": "allow",
            "helm template *": "allow",
            "html2markdown *": "allow",
            "jq *": "allow",
            "ls *": "allow",
            "mkdir *": "allow",
            "printf *": "allow",
            "python3 -m json.tool *": "allow",
            "pwd": "allow",
            "rg *": "allow",
            "scripts/notion_mcp.py call notion-fetch": "allow",
            "sed *": "allow",
            "set -e": "allow",
            "sort *": "allow",
            "tail *": "allow",
            "uniq *": "allow",
            "wc *": "allow",
            "which *": "allow",
            "yq *": "allow"
        },
        "external_directory": {
            "*": "ask",
            "~/.config/opencode/skills/*": "allow",
            "~/.nodenv/versions/*/lib/node_modules/@earendil-works/pi-coding-agent/docs/*": "allow",
            "~/Code/*": "allow",
            "/tmp/*": "allow"
        }
    }
}
